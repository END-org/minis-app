# Copy this file to .env for local Docker Compose and Spring Boot values.
# The backend includes spring-dotenv, so root .env values are visible to Spring Boot.

POSTGRES_DB=minis_event_local
POSTGRES_USER=minis
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

MINIO_ROOT_USER=minisadmin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_STORAGE_BUCKET=

GOOGLE_APPLICATION_CREDENTIALS=

# Demo deployment skeleton. Values with passwords or credential paths must be supplied locally.
DEMO_POSTGRES_DB=minis_event_demo
DEMO_POSTGRES_USER=minis_demo
DEMO_POSTGRES_PASSWORD=
DEMO_POSTGRES_PORT=5434

DEMO_MINIO_ROOT_USER=
DEMO_MINIO_ROOT_PASSWORD=
DEMO_MINIO_API_PORT=9002
DEMO_MINIO_CONSOLE_PORT=9003

DEMO_HTTP_PORT=8088
MINIS_LOCAL_ALLOWED_ORIGINS=http://localhost:5173
MINIS_DEMO_ALLOWED_ORIGINS=http://localhost:8088
MINIS_PROD_ALLOWED_ORIGINS=

# Disabled by default. Local/demo only, comma-separated Firebase UIDs for initial event admins.
MINIS_EVENT_ADMIN_BOOTSTRAP_ENABLED=false
MINIS_EVENT_ADMIN_BOOTSTRAP_FIREBASE_UIDS=

# React event app local development. Public Firebase Web SDK values are safe in the browser.
# Leave VITE_API_BASE_URL blank for the local Vite proxy and demo same-origin routing.
MINIS_EVENT_APP_DEV_HOST=localhost
MINIS_EVENT_APP_DEV_PORT=5173
MINIS_EVENT_APP_DEV_PROXY_TARGET=http://localhost:8080
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
