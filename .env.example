# Copy this file to .env for local Docker Compose values.
# Spring Boot reads normal environment variables; it does not parse .env directly.

POSTGRES_DB=minis_local
POSTGRES_USER=minis
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5433

MINIO_ROOT_USER=minisadmin
MINIO_ROOT_PASSWORD=change-me-local-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-public-web-api-key
FIREBASE_WEB_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_WEB_APP_ID=your-public-web-app-id
FIREBASE_WEB_STORAGE_BUCKET=your-firebase-project-id.appspot.com
