# Copy this file to .env, then fill the required local and demo values.
# The local backend launcher and Docker Compose use the root .env file. Keep it private.

# PostgreSQL - local infrastructure
POSTGRES_DB=minis_event_local
POSTGRES_USER=minis
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Direct backend datasource overrides; demo Compose derives these from DEMO_POSTGRES_*.
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# MinIO - local infrastructure
MINIO_ROOT_USER=minisadmin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Spring Boot - local backend
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
MINIS_SQL_LOGGING=false
MINIS_SQL_FORMAT=false

# Firebase backend and local diagnostics
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# Content storage
# Endpoints are profile-sensitive. Leave these unset to use the host-local and Docker-demo defaults.
# MINIS_CONTENT_STORAGE_INTERNAL_ENDPOINT=
# MINIS_CONTENT_STORAGE_PUBLIC_ENDPOINT=
# Optional credential overrides; local/demo normally inherit the matching MinIO credentials.
# MINIS_CONTENT_STORAGE_ACCESS_KEY=
# MINIS_CONTENT_STORAGE_SECRET_KEY=
MINIS_CONTENT_STORAGE_BUCKET=minis-event-media
MINIS_CONTENT_STORAGE_SIGNED_READ_LIFETIME=PT10M
MINIS_CONTENT_STORAGE_CONNECT_TIMEOUT=PT5S
MINIS_CONTENT_STORAGE_READ_TIMEOUT=PT30S
MINIS_CONTENT_STORAGE_WRITE_TIMEOUT=PT2M
MINIS_CONTENT_STORAGE_AUTO_CREATE_BUCKET=false

# Curated media importer and reconciliation - disabled during normal startup
MINIS_CONTENT_IMPORTER_ENABLED=false
MINIS_CONTENT_IMPORTER_MANIFEST_PATH=
MINIS_CONTENT_IMPORTER_ASSETS_ROOT=
MINIS_CONTENT_IMPORTER_FFPROBE_PATH=ffprobe
MINIS_CONTENT_IMPORTER_PROBE_TIMEOUT=PT10S
MINIS_CONTENT_IMPORTER_MAX_PROBE_OUTPUT_BYTES=1048576
MINIS_CONTENT_RECONCILIATION_ENABLED=false

# CORS
MINIS_LOCAL_ALLOWED_ORIGINS=http://localhost:5173
MINIS_DEMO_ALLOWED_ORIGINS=http://localhost:8088
MINIS_PROD_ALLOWED_ORIGINS=

# Event-admin bootstrap - local/demo only
MINIS_EVENT_ADMIN_BOOTSTRAP_ENABLED=false
MINIS_EVENT_ADMIN_BOOTSTRAP_FIREBASE_UIDS=

# React/Vite local development
# Mirror these values in web/event-app/.env.local; Vite does not read the root .env file.
MINIS_EVENT_APP_DEV_HOST=localhost
MINIS_EVENT_APP_DEV_PORT=5173
MINIS_EVENT_APP_PREVIEW_PORT=4173
MINIS_EVENT_APP_DEV_PROXY_TARGET=http://localhost:8080
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Demo environment
DEMO_POSTGRES_DB=minis_event_demo
DEMO_POSTGRES_USER=minis_demo
DEMO_POSTGRES_PASSWORD=
DEMO_POSTGRES_PORT=5434
DEMO_MINIO_ROOT_USER=
DEMO_MINIO_ROOT_PASSWORD=
DEMO_MINIO_API_PORT=9002
DEMO_MINIO_CONSOLE_PORT=9003
DEMO_HTTP_PORT=8088
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
